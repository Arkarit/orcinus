#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Orcinus contributors
# SPDX-License-Identifier: GPL-2.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

# Safe release defaults (see CLAUDE.md / docs/releasing.md): no development automation, no
# FileManager1 registration, no Dolphin-named files, no telemetry. The tests run in CI and in
# the distribution containers; Launchpad's builders have no session bus or network for them.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DBUILD_TESTING=OFF \
		-DWHALE_DEV_BUILD=OFF \
		-DWHALE_ENABLE_DEV_MCP=OFF \
		-DWHALE_PROVIDE_FILEMANAGER1=OFF \
		-DWHALE_INSTALL_DOLPHIN_EXTRAS=OFF \
		-DWHALE_WITH_MPV=ON

override_dh_auto_test:
	cmake -DBUILD_DIR=$(CURDIR)/obj-$(DEB_HOST_GNU_TYPE) -P cmake/WhaleReleaseCheck.cmake

# All shared libraries live in the private directory /usr/lib/<arch>/orcinus: no ldconfig
# trigger, no shlibs for other packages.
override_dh_makeshlibs:
	dh_makeshlibs --no-scripts
