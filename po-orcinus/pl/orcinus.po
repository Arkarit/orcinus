#: admin/workerintegration.cpp:54
#, kde-kuit-format
msgctxt "@info:shell"
msgid ""
"<application>Orcinus</application> requires <application>%1</application> to "
"manage system-controlled files, but it is not installed.<nl/>Press %2 to "
"install <application>%1</application> or %3 to cancel."
msgstr ""
"<application>Orcinus</application> wymaga <application>%1</application> do "
"zarządzania plikami kontrolowanymi przez system, ale nie jest on "
"zainstalowany.<nl/>Naciśnij %2, aby zainstalować <application>%1</"
"application>, lub %3, aby anulować."

#: admin/workerintegration.cpp:82
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>Make use of your administrator rights in Orcinus:"
"<numberedlist><numbereditem>Navigate to the file or folder you want to "
"change.</numbereditem><numbereditem>Activate the \"%1\" action either under "
"<interface>Open Menu|More|View</interface> or <interface>Menu Bar|View</"
"interface>.<nl/>Default shortcut: <shortcut>%2</shortcut></"
"numbereditem><numbereditem>After authorization you can manage files as an "
"administrator.</numbereditem></numberedlist></para>"
msgstr ""
"<para>Korzystanie z uprawnień administratora w Orcinus:"
"<numberedlist><numbereditem>Przejdź do pliku lub katalogu, który chcesz "
"zmienić.</numbereditem><numbereditem>Włącz działanie „%1” w "
"<interface>Otwórz menu|Więcej|Widok</interface> albo w <interface>Pasek menu|"
"Widok</interface>.<nl/>Domyślny skrót: <shortcut>%2</shortcut></"
"numbereditem><numbereditem>Po uwierzytelnieniu możesz zarządzać plikami jako "
"administrator.</numbereditem></numberedlist></para>"

