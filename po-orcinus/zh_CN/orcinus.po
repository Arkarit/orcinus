#: whale/ai/whaleaidisclaimer.cpp:76
#, kde-format
msgctxt "@info"
msgid ""
"If you are new to AI agents, experiment in a virtual machine first. You can "
"run Orcinus inside one."
msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:77
#, kde-format
msgctxt "@info lead of a list item"
msgid "Know the basics."
msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:79
#, kde-format
msgctxt "@info"
msgid ""
"Familiarity with Linux users, permissions, and file systems is strongly "
"recommended. Advanced system administration knowledge is helpful, but not "
"required."
msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:81
#, kde-format
msgctxt "@info lead of a list item"
msgid "Ask when unsure."
msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:82
#, kde-format
msgctxt "@info"
msgid ""
"If you do not understand an action or its consequences, ask the agent to "
"explain before proceeding."
msgstr ""

