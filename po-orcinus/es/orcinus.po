#: admin/workerintegration.cpp:54
#, kde-kuit-format
msgctxt "@info:shell"
msgid ""
"<application>Orcinus</application> requires <application>%1</application> to "
"manage system-controlled files, but it is not installed.<nl/>Press %2 to "
"install <application>%1</application> or %3 to cancel."
msgstr ""
"<application>Orcinus</application> necesita <application>%1</application> "
"para gestionar archivos controlados por el sistema, pero no está instalado."
"<nl/>Pulse %2 para instalar <application>%1</application> o %3 para cancelar."

#: admin/workerintegration.cpp:82
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>Make use of your administrator rights in Orcinus:"
"<numberedlist><numbereditem>Navigate to the file or folder you want to "
"change.</numbereditem><numbereditem>Activate the \"%1\" action either under "
"<interface>Open Menu|More|View</interface> or <interface>Menu Bar|View</"
"interface>.<nl/>Default shortcut: <shortcut>%2</shortcut></"
"numbereditem><numbereditem>After authorization you can manage files as an "
"administrator.</numbereditem></numberedlist></para>"
msgstr ""
"<para>Use sus derechos de administrador en Orcinus:"
"<numberedlist><numbereditem>Vaya al archivo o la carpeta que quiera cambiar."
"</numbereditem><numbereditem>Active la acción «%1» en <interface>Abrir menú|"
"Más|Ver</interface> o en <interface>Barra de menú|Ver</interface>.<nl/>Atajo "
"predeterminado: <shortcut>%2</shortcut></numbereditem><numbereditem>Tras la "
"autorización podrá gestionar archivos como administrador.</numbereditem></"
"numberedlist></para>"

