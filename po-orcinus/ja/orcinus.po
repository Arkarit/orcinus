msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:83
#, kde-format
msgctxt "@info"
msgid "Protect important files before giving agents access to your system."
msgstr ""

#: whale/ai/whaleaidisclaimer.cpp:84
#, kde-format
msgctxt "@info lead of a list item"
